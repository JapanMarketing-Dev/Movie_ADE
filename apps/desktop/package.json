{
  "name": "@solocut/desktop",
  "productName": "Solocut",
  "version": "0.1.0",
  "private": true,
  "description": "The ADE for video editing",
  "author": "JapanMarketing-Dev",
  "license": "MIT",
  "homepage": "https://solocut.app",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run --root ../.. apps/desktop/test",
    "icons": "node scripts/make-icons.mjs",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64 --config electron-builder.config.cjs",
    "dist:mac:all": "electron-vite build && electron-builder --mac --arm64 --x64 --config electron-builder.config.cjs",
    "dist:win": "electron-vite build && electron-builder --win --config electron-builder.config.cjs",
    "dist:linux": "electron-vite build && electron-builder --linux --config electron-builder.config.cjs"
  },
  "dependencies": {
    "@sentry/electron": "^8.1.0",
    "node-pty": "1.2.0-beta.15"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "@solocut/agents": "workspace:*",
    "@solocut/archive": "workspace:*",
    "@solocut/captions": "workspace:*",
    "@solocut/core": "workspace:*",
    "@solocut/decide": "workspace:*",
    "@solocut/media": "workspace:*",
    "@solocut/settings": "workspace:*",
    "@solocut/templates": "workspace:*",
    "@solocut/toolchain": "workspace:*",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "44.7.0",
    "electron-builder": "^26.15.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.540.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "vite": "^7.0.0"
  }
}
